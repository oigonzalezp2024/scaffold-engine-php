
{
    "name": "oigonzalezp2024/scaffold-engine",
    "description": "A clean-architecture PHP engine for dynamic file scaffolding, template replacement, and module provisioning.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "scaffolding",
        "clean-architecture",
        "template-replacer",
        "generator",
        "cli",
        "provisioning"
    ],
    "authors": [
        {
            "name": "Óscar Iván González Peña",
            "role": "Lead Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Oigonzalezp2024\\ScaffoldEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oigonzalezp2024\\ScaffoldEngine\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/console.php"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
